Table city {
  id int [pk, increment]
  name varchar(250) [not null, unique, note: 'Nome']
  state_id int [not null, ref: > state.id, note: 'Estado']
  Note: 'Cidade'
}

Table country {
  id int [pk, increment]
  code varchar(250) [not null, unique, note: 'Codigo']
  name varchar(250) [not null, unique, note: 'Nome']
  Note: 'Pais'
}

Table forum_categoria {
  id int [pk, increment]
  description varchar(150) [not null, note: 'Descrição']
  name varchar(250) [not null, unique, note: 'nome']
  Note: 'forum_categoria'
}

Table forum_resposta {
  id int [pk, increment]
  content text [not null, note: 'conteúdo']
  moment timestamp [note: 'momento']
  people_id int [not null, ref: > people.id, note: 'pessoa_id']
  topic_id int [not null, ref: > forum_topico.id, note: 'tópico_id']
  Note: 'forum_resposta'
}

Table forum_topico {
  id int [pk, increment]
  content text [not null, note: 'conteúdo']
  forum_category_id int [not null, ref: > forum_categoria.id, note: 'forum_categoria']
  last_activity_at timestamp [note: 'útilma_atividade_em']
  moment timestamp [note: 'momento']
  people_id int [not null, ref: > people.id, note: 'pessoa_id']
  title varchar(200) [not null, note: 'título']
  Note: 'forum_tópico'
}

Table friend {
  id int [pk, increment]
  accepted_at timestamp [note: 'Aceitado Em']
  friend_id int [not null, ref: > people.id, note: 'Amigo']
  people_id int [not null, ref: > people.id, note: 'Pessoa']
  request_at timestamp [not null, note: 'Pedido Em']
  Note: 'Amigo'
}

Table institution {
  id int [pk, increment]
  address text [note: 'Endereço']
  avatar text [note: 'Avatar']
  city_id int [not null, ref: > city.id, note: 'Cidade']
  cover_image text [note: 'Imagem de Capa']
  description text [note: 'Descrição']
  email varchar(250) [note: 'E-mail']
  instagram varchar(250) [note: 'Instagram']
  name varchar(250) [not null, note: 'Nome']
  post_code varchar(250) [note: 'Código Postal']
  telephone int [note: 'Telefone']
  website varchar(250) [note: 'Website']
  Note: 'Instituição'
}

Table messages {
  id int [pk, increment]
  deleted_at timestamp [note: 'Apagada Em']
  edited_at timestamp [note: 'Editado Em']
  message text [note: 'Mensagem']
  originator_id int [ref: > people.id, note: 'Originador']
  parent_id int [ref: > messages.id, note: 'Pai']
  reaction varchar(1) [note: 'Reação']
  read_at timestamp [note: 'Lido Em']
  recipient_id int [not null, ref: > people.id, note: 'Destinatário']
  sent_at timestamp [not null, note: 'Enviado Em']
  Note: 'Mensagens'
}

Table notification {
  id int [pk, increment]
  content text [note: 'Conteúdo']
  extra text [note: 'Dados Adicionais']
  originator_id int [ref: > people.id, note: 'Originador']
  read_at timestamp [note: 'Lido Em']
  recipient_id int [not null, ref: > people.id, note: 'Destinatário']
  sent_at timestamp [not null, note: 'Enviado Em']
  title varchar(250) [not null, note: 'Título']
  type_id int [not null, ref: > notification_type.id, note: 'Tipo']
  Note: 'Notificação'
}

Table notification_opt_out {
  id int [pk, increment]
  people_id int [not null, ref: > people.id, note: 'Pessoa']
  type_id int [not null, ref: > notification_type.id, note: 'Tipo']
  Note: 'Bloqueios'
}

Table notification_queue {
  id int [pk, increment]
  entity_uid uuid [not null, note: 'UID da entidade']
  originator_id int [not null, ref: > people.id, note: 'Originador']
  type_id int [not null, ref: > notification_type.id, note: 'Tipo']
  Note: 'Fila'
}

Table notification_type {
  id int [pk, increment]
  code varchar(250) [not null, unique, note: 'Código']
  name varchar(250) [not null, unique, note: 'Name']
  Note: 'Tipo'
}

Table people {
  id int [pk, increment]
  accepted_terms_at timestamp [note: 'Termos Aceites Em']
  avatar text [note: 'Avatar']
  birth_date date [not null, note: 'Data de Nascimento']
  city_id int [not null, ref: > city.id, note: 'Cidade']
  cover_image text [note: 'Imagem de Capa']
  description text [note: 'Descrição']
  email varchar(250) [not null, unique, note: 'Email']
  institution_id int [not null, ref: > institution.id, note: 'Instituição']
  name varchar(250) [not null, note: 'Nome']
  order varchar(250) [not null, unique, note: 'Ordem']
  people_user_id int [not null, unique, note: 'Utilizador']
  recovery_key varchar(250) [note: 'Chave de Recuperação']
  recovery_limit timestamp [note: 'Limite de Recuperação']
  Note: 'Pessoa'
}

Table people_ws_session {
  id int [pk, increment]
  people_id int [not null, ref: > people.id, note: 'Pessoa']
  session_id varchar(250) [not null, note: 'Sessão ID']
  Note: 'Sessão WS'
}

Table post {
  id int [pk, increment]
  comments int [note: 'Comentários']
  content text [not null, note: 'Conteúdo']
  likes int [note: 'Likes']
  moment timestamp [not null, note: 'Momento']
  parent_id int [ref: > post.id, note: 'Pai']
  people_id int [not null, ref: > people.id, note: 'Pessoa']
  Note: 'Publicação'
}

Table post_like {
  id int [pk, increment]
  moment timestamp [not null, note: 'Momento']
  people_id int [not null, ref: > people.id, note: 'Pessoa']
  post_id int [not null, ref: > post.id, note: 'Publicação']
  Note: 'Like'
}

Table service {
  id int [pk, increment]
  category_id int [not null, ref: > service_category.id, note: 'Categoria']
  city_id int [not null, ref: > city.id, note: 'Cidade']
  description varchar(250) [note: 'Descrição']
  instagram varchar(250) [note: 'Instagram']
  name varchar(250) [not null, note: 'Nome']
  phone varchar(250) [note: 'Telefone']
  website varchar(250) [note: 'Website']
  Note: 'Prestação de Serviço'
}

Table service_category {
  id int [pk, increment]
  description varchar(250) [note: 'Descrição']
  name varchar(250) [not null, note: 'Nome']
  Note: 'Categoria de Serviço'
}

Table state {
  id int [pk, increment]
  code varchar(250) [not null, unique, note: 'Codigo']
  country_id int [not null, ref: > country.id, note: 'Pais']
  name varchar(250) [not null, unique, note: 'Nome']
  Note: 'Estado'
}

