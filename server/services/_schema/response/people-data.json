{
  "type": "object",
  "properties": {
    "uid": {
      "type": "uid"
    },
    "name": {
      "type": "string-not-empty"
    },
    "username": {
      "type": "string-not-empty",
      "pattern": "^[a-z]+[a-z0-9]{1,24}$"
    },
    "description": {
      "type": "string"
    },
    "email": {
      "type": "string-not-empty",
      "format": "email"
    },
    "avatar": {
      "type": "boolean"
    },
    "cover_image": {
      "type": "boolean"
    },
    "birthDate": {
      "type": "string-not-empty",
      "format": "date"
    },
    "city": {
      "_schema": "response/location-unit"
    },
    "state": {
      "_schema": "response/location-unit"
    },
    "country": {
      "_schema": "response/location-unit"
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string-not-empty"
        },
        "code": {
          "type": "string-not-empty"
        }
      },
      "required": [
        "name",
        "code"
      ]
    },
    "institution": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string-not-empty"
        },
        "uid": {
          "type": "uid"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "uid"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "acceptedTermsAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "unread_messages": {
      "type": "integer",
      "description": "Only present on friend listings."
    },
    "online": {
      "type": "boolean",
      "description": "Only present on friend listings."
    },
    "last_message": {
      "type": "string",
      "description": "Only present on friend listings."
    },
    "last_message_at": {
      "type": "string",
      "description": "Only present on friend listings."
    }
  },
  "required": [
    "uid",
    "name",
    "username",
    "description",
    "email",
    "avatar",
    "cover_image",
    "birthDate",
    "city",
    "state",
    "country",
    "group",
    "institution",
    "active",
    "acceptedTermsAt"
  ]
}
